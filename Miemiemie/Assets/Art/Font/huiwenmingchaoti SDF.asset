    characterSequence: "\u4E8B\u4EF6\r\n\u7EA2\u5B57\u4E3A\u6982\u7387\r\n\u7EA2\u5E95\u4E3A\u6389\u843D\u7269\r\n\u9EC4\u5E95\u4E3A\u6548\u679C\r\n\u6D4B\u8BD5\u6570\u636E\u4E4B\u524D\u7684\u5236\u4F5C\u9636\u6BB5\u53EF\u4EE5\u628A\u6982\u7387\u5168\u5199\u621050%\r\n\r\n\u4E8B\u4EF601\uFF1A\u8840\u82D4\u796D\u575B\r\n\u6587\u6848\r\n
      \u6797\u95F4\u7A7A\u5730\u4E0A\uFF0C\u4E00\u7247\u7329\u7EA2\u8272\u7684\u82D4\u85D3\u8986\u76D6\u7740\u5929\u7136\u5F62\u6210\u7684\u77F3\u53F0\uFF0C\u6563\u53D1\u7740\u5F02\u9999\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u6EF4\u8840\u732E\u796D\r\n\u25CF\u6210\u529F\u7387\uFF1A\u5F53\u524D\u8840\u91CF/\u6700\u5927\u8840\u91CF\r\n\u25CF\u6210\u529F\uFF1A\u82D4\u85D3\u6536\u7F29\uFF0C\u5410\u51FA\u4E00\u4E2A\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u82D4\u85D3\u75AF\u72C2\u8513\u5EF6\uFF0C\u7F20\u4F4F\u4F60\u7684\u624B\u81C2\u5438\u8840\u3002\u5931\u53BB1\u5FC3\u8840\u91CF\u3002\r\n\r\n\u9009\u9879B
      \u2014\u2014 \u7ED5\u5F00\r\n\u25CF\u6210\u529F\u7387\uFF1A100%\r\n\u25CF\u7ED3\u679C\uFF1A\u65E0\u6536\u83B7\uFF0C\u4E5F\u65E0\u60E9\u7F5A\u3002\r\n\r\n\u4E8B\u4EF602\uFF1A\u5012\u60AC\u7684\u8346\u68D8\u5DE2\r\n\u6587\u6848\r\n
      \u4E00\u68F5\u5DE8\u6811\u7684\u679D\u5E72\u4E0A\u5012\u6302\u7740\u4E00\u4E2A\u7531\u8346\u68D8\u7F16\u7EC7\u800C\u6210\u7684\u5DE8\u5927\u5DE2\u7A74\uFF0C\u4F20\u51FA\u7EC6\u5FAE\u7684\u5431\u5431\u58F0\r\n
      \u5DE2\u7A74\u5E95\u90E8\uFF0C\u4E00\u9897\u53D1\u5149\u7684\u7425\u73C0\u7F13\u7F13\u6EF4\u843D\u6811\u8102\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u70B9\u71C3\u5DE2\u7A74\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784040%(\u643A\u5E26\u707C\u70E7\u6A21\u5F0F\u5219\u4E3A100%)\r\n\u25CF\u6210\u529F\uFF1A\u5DE2\u7A74\u71C3\u70E7\uFF0C\u5E7C\u517D\u9003\u6563\uFF0C\u6389\u843D\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u71C3\u70E7\u5F15\u53D1\u7206\u70B8\uFF0C\u6548\u679C\uFF1A\u8840\u91CF\u4E0A\u9650-0.5\u3002\r\n\u9009\u9879B
      \u2014\u2014 \u7B49\u5F85\u5E7C\u517D\u79BB\u5DE2\r\n\u25CF\u6210\u529F\u7387\uFF1A30%
      \r\n\u25CF\u6210\u529F\uFF1A\u5E7C\u517D\u79BB\u5DE2\uFF0C\u5DE2\u7A74\u7A7A\u7F6E\uFF0C\u6389\u843D\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u5E7C\u517D\u53D1\u73B0\u4F60\uFF0C\u96C6\u4F53\u653B\u51FB\u3002\u6548\u679C\uFF1A\u5F3A\u5236\u6218\u6597,\u968F\u673A\u4E09\u53EA\u5C0F\u602A\uFF0C\u65E0\u989D\u5916\u6389\u843D\u3002\r\n\r\n\u4E8B\u4EF603\uFF1A\u8150\u5316\u6CC9\u773C\r\n\u6587\u6848\r\n
      \u4E00\u6C6A\u9ED1\u8272\u6CC9\u6C34\u4ECE\u6811\u6839\u4E0B\u6D8C\u51FA\uFF0C\u6CC9\u5E95\u9690\u7EA6\u53EF\u89C1\u4E00\u679A\u53D1\u5149\u7684\u517D\u7259\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u635E\u8D77\u517D\u7259\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784040%\r\n\u25CF\u6210\u529F\uFF1A\u635E\u51FA\u517D\u7259\uFF0C\u672C\u573A\u6218\u6597\u83B7\u5F97\u653B\u51FB+20%\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u83CC\u4E1D\u89E6\u624B\u7F20\u4F4F\u624B\u8155\u3002\u6548\u679C\uFF1A\u8FDB\u5165\u4E00\u4E2A\u65B0\u623F\u95F4\u65F6\u635F\u59310.5\u5FC3\uFF0C\u6301\u7EED2\u8F6E(\u4E24\u4E2A\u623F\u95F4)\u3002\r\n\u9009\u9879B
      \u2014\u2014 \u5411\u6CC9\u773C\u6295\u5165\u7075\u9B42\u77F3\r\n\u25CF\u6210\u529F\u7387\uFF1A100%\uFF08\u6D88\u80175\u9897\u7075\u9B42\u77F3\uFF09\r\n\u25CF\u7ED3\u679C\uFF1A\u6CC9\u773C\u6CB8\u817E\u540E\u5E73\u9759\uFF0C\u517D\u7259\u6D6E\u51FA\uFF0C\u83B7\u5F97\u4E00\u4E2A\u9053\u5177\u3002\r\n\r\n\u4E8B\u4EF604\uFF1A\u5F71\u72D0\u7684\u4EA4\u6613\r\n\u6587\u6848\r\n
      \u4E00\u53EA\u6D51\u8EAB\u6F06\u9ED1\u3001\u62D6\u7740\u4E09\u6761\u5C3E\u5DF4\u7684\u72D0\u72F8\u8E72\u5728\u8DEF\u4E2D\u592E\u3002\r\n
      \u5B83\u9762\u524D\u653E\u7740\u4E00\u7247\u5DE8\u5927\u7684\u6811\u53F6\uFF0C\u6811\u53F6\u4E00\u7AEF\u538B\u7740\u4F60\u7684\u5F71\u5B50\uFF0C\u72D0\u72F8\u51B2\u7740\u4F60\u6B6A\u5934\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u653B\u51FB\u72D0\u72F8\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784030%
      + \u653B\u51FB\u529B\xD75%\r\n\u25CF\u6210\u529F\uFF1A\u5F71\u72D0\u5316\u4E3A\u70DF\u96FE\uFF0C\u65E0\u989D\u5916\u6389\u843D\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u5F71\u72D0\u5316\u8EAB\u6210\u4E09\u53EA\u602A\uFF0C\u56F4\u653B\u4F60\u3002\u6548\u679C\uFF1A\u5F3A\u5236\u6218\u6597\u968F\u673A\u4E09\u53EA\u5C0F\u602A\uFF0C\u80DC\u5229\u540E\u65E0\u989D\u5916\u6389\u843D\u3002\r\n\u9009\u9879B
      \u2014\u2014 \u732E\u4E0A\u730E\u7269\uFF08\u6D88\u8017\u672C\u6B21\u72E9\u730E\u5DF2\u83B7\u5F97\u76841\u4E2A\u968F\u673A\u9053\u5177\uFF09(\u6CA1\u6709\u5219\u4E0D\u53EF\u9009)\r\n\u25CF\u6210\u529F\u7387\uFF1A100%\r\n\u25CF\u7ED3\u679C\uFF1A\u5F71\u72D0\u6EE1\u610F\u79BB\u53BB\uFF0C\u5F71\u5B50\u91CA\u653E\u3002\u6548\u679C:\u4E0B\u6B21\u53D7\u4F24\u514D\u75AB\uFF0C\u4EC5\u4E00\u6B21\u3002\r\n\r\n\u4E8B\u4EF605\uFF1A\u661F\u843D\u82D4\u539F\r\n\u6587\u6848\r\n
      \u4E00\u5757\u9668\u77F3\u7838\u7A7F\u4E86\u6797\u51A0\uFF0C\u9668\u77F3\u8868\u9762\u957F\u6EE1\u4E86\u53D1\u5149\u7684\u84DD\u8272\u82D4\u85D3\uFF0C\u82D4\u85D3\u4E2D\u5D4C\u7740\u65E0\u6570\u7EC6\u5C0F\u7684\u7ED3\u6676\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u522E\u4E0B\u82D4\u85D3\u7ED3\u6676\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784020%
      + \u5C04\u901F\xD75%\r\n\u25CF\u6210\u529F\uFF1A\u6548\u679C:\u672C\u573A\u6218\u6597\u4E2D\u8840\u91CF\u4E0A\u9650+1\r\n\u25CF\u5931\u8D25\uFF1A\u5B62\u5B50\u7206\u70B8\uFF0C\u6548\u679C\uFF1A\u672C\u6B21\u6218\u6597\u4E2D\uFF0C\u4F60\u7684\u5B50\u5F39\u670910%\u7684\u5931\u8BEF\u7387\u3002\r\n\u9009\u9879B
      \u2014\u2014 \u8EBA\u5728\u9668\u77F3\u5751\u4E2D\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784010%
      + (\u6700\u5927\u8840\u91CF-\u5F53\u524D\u8840\u91CF)/\u6700\u5927\u8840\u91CF\xD740%\r\n\u25CF\u6210\u529F\uFF1A\u83B7\u5F97\u661F\u4E4B\u795D\u798F\u3002\u6548\u679C\uFF1A\u672C\u573A\u6218\u6597\u4E2D\u5C04\u7A0B+1\uFF0C\u5C04\u901F+0.5\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u88AB\u82D4\u85D3\u540C\u5316\u3002\u6548\u679C\uFF1A\u635F\u59311.5\u5FC3\u3002\r\n\r\n\u4E8B\u4EF606\uFF1A\u96F7\u51FB\u6728\r\n\u6587\u6848\r\n
      \u4E00\u68F5\u88AB\u96F7\u5288\u6210\u4E24\u534A\u7684\u53E4\u6811\uFF0C\u65AD\u9762\u7126\u9ED1\uFF0C\u4ECD\u5728\u5192\u70DF\u3002\u6811\u5FC3\u9732\u51FA\u4E00\u622A\u6728\u82AF\uFF0C\u6563\u53D1\u7740\u81ED\u6C27\u7684\u6C14\u5473\uFF0C\u5468\u56F4\u7684\u5730\u9762\u6709\u5FAE\u5F31\u7684\u7535\u6D41\u8DF3\u52A8\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u5F92\u624B\u62D4\u51FA\u6728\u82AF\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784030%
      + \u5F53\u524D\u8840\u91CF/\u6700\u5927\u8840\u91CF\xD720%\r\n\u25CF\u6210\u529F\uFF1A\u83B7\u5F97\u9053\u5177,\u653B\u51FB+50%.\r\n\u25CF\u5931\u8D25\uFF1A\u88AB\u7535\u51FB\uFF0C\u635F\u59311\u5FC3\uFF0C\u653B\u51FB-50%\uFF0C\u6301\u7EED1\u8F6E(\u4E00\u4E2A\u623F\u95F4)\u3002\r\n\u9009\u9879C
      \u2014\u2014 \u79BB\u5F00\r\n\u25CF\u6210\u529F\u7387\uFF1A100%\r\n\u25CF\u79BB\u5F00\u65F6\u88AB\u96F7\u5288\u4E2D,\u5C04\u901F-0.5,\u6263\u96640.5\u5FC3\r\n\u4E8B\u4EF607\uFF1A\u8840\u6708\u82B1\u82DE\r\n\u6587\u6848\r\n
      \u4E00\u682A\u9ED1\u8272\u7684\u82B1\u82DE\u4ECE\u8150\u6B96\u571F\u4E2D\u94BB\u51FA\uFF0C\u82B1\u74E3\u7D27\u95ED\uFF0C\u82B1\u82DE\u5728\u5FAE\u5FAE\u640F\u52A8\uFF0C\u5468\u56F4\u7684\u5730\u9762\u5DF2\u7ECF\u7126\u9ED1\uFF0C\u5BF8\u8349\u4E0D\u751F\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u6458\u53D6\u82B1\u82DE\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784050%
      + \u5F53\u524D\u8840\u91CF/\u6700\u5927\u8840\u91CF\xD720%\r\n\u25CF\u6210\u529F\uFF1A\u82B1\u82DE\u7EFD\u653E\u540E\u67AF\u840E\uFF0C\u83B7\u5F97\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u82B1\u82DE\u7206\u70B8\u91CA\u653E\u82B1\u7C89\uFF0C\u5C04\u7A0B-0.5\u3002\r\n\u9009\u9879C
      \u2014\u2014 \u7528\u706B\u70E7\u6BC1\r\n\u25CF\u6210\u529F\u7387\uFF1A100%\r\n\u25CF\u7ED3\u679C\uFF1A\u82B1\u82DE\u5316\u4E3A\u7070\u70EC\uFF0C\u83B7\u5F97[\u7075\u9B42\u82B1\u79CD\u5B50*1]\u3002\r\n\r\n\u4E8B\u4EF608\uFF1A\u85E4\u8513\u7EDE\u6740\u9677\u9631\r\n\u6587\u6848\r\n
      \u5730\u9762\u9686\u8D77\u4E00\u5708\u5708\u6D3B\u52A8\u7684\u85E4\u8513\uFF0C\u4E2D\u592E\u6709\u4E00\u5177\u88AB\u85E4\u8513\u52D2\u5F97\u9AA8\u9ABC\u53D8\u5F62\u9E8B\u9E7F\u7684\u5C38\u4F53,\u5C38\u4F53\u4E0A\u6709\u4EC0\u4E48\u4E1C\u897F\u5728\u9690\u9690\u53D1\u5149\u3002\r\n\r\n\u9009\u9879A
      \u2014\u2014 \u5FEB\u901F\u51B2\u8FDB\u53BB\u6361\u8D77\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784040%
      + \u5C04\u901F*5%\r\n\u25CF\u6210\u529F\uFF1A\u83B7\u5F97\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u88AB\u85E4\u8513\u7F20\u4F4F\uFF0C\u635F\u59310.5\u5FC3\uFF0C\u5C04\u7A0B-0.5\u3002\r\n\u9009\u9879B
      \u2014\u2014 \u732E\u4E0A\u730E\u7269\uFF08\u6D88\u8017\u968F\u673A\u4E00\u4E2A\u9053\u5177\uFF09\r\n\u25CF\u6210\u529F\u7387\uFF1A90%\r\n\u25CF\u6210\u529F\uFF1A\u85E4\u8513\u677E\u5F00\uFF0C\u83B7\u5F97\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u65E0\u4E8B\u53D1\u751F\r\n\r\n\u4E8B\u4EF609\uFF1A\u56DE\u58F0\u6D1E\u7A74\r\n\u6587\u6848\r\n
      \u4E00\u68F5\u5DE8\u6811\u7684\u6839\u90E8\u6709\u4E00\u4E2A\u5929\u7136\u7684\u6811\u6D1E\uFF0C\u6DF1\u4E0D\u89C1\u5E95\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u5411\u6D1E\u91CC\u558A\u8BDD\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784050%
      + \u5F53\u524D\u8840\u91CF/\u6700\u5927\u8840\u91CF\xD730%\r\n\u25CF\u6210\u529F\uFF1A\u6D1E\u4E2D\u4F20\u6765\u4F4E\u541F\uFF0C\u83B7\u5F97\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u5486\u54EE\u9707\u4F24\u8033\u819C\uFF0C\u635F\u59310.5\u5FC3\uFF0C\u5C04\u7A0B-1\u683C\u3002\r\n\u9009\u9879B
      \u2014\u2014 \u6254\u4E00\u5757\u77F3\u5934\u8FDB\u53BB\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784070%
      + \u653B\u51FB\u529B\xD75%\r\n\u25CF\u6210\u529F\uFF1A\u6D1E\u4E2D\u751F\u7269\u75DB\u568E\uFF0C\u5C04\u7A0B-1,\u83B7\u5F97\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u751F\u7269\u51B2\u51FA\u6D1E\uFF0C\u5F3A\u5236\u6218\u6597,\u968F\u5373\u5C0F\u602A*2\uFF0C\u80DC\u5229\u540E\u6389\u843D\u9053\u5177\u3002\r\n\r\n\u4E8B\u4EF610\uFF1A\u8150\u751F\u82B1\u4E1B\r\n\u6587\u6848\r\n
      \u4E00\u7C07\u5DE8\u5927\u7684\u8150\u751F\u82B1\u4ECE\u8150\u70C2\u7684\u6811\u5E72\u4E0A\u957F\u51FA\u3002\u5176\u4E2D\u4E00\u6735\u82B1\u7684\u4E2D\u5FC3\uFF0C\u6709\u4E00\u9897\u62F3\u5934\u5927\u7684[\u8150\u5375]\u3002\r\n\u9009\u9879A
      \u2014\u2014 \u5F92\u624B\u53D6\u5375\r\n\u25CF\u6210\u529F\u7387\uFF1A\u57FA\u784020%
      + \u5F53\u524D\u8840\u91CF\xD730%\r\n\u25CF\u6210\u529F\uFF1A\u83B7\u5F97\u9053\u5177\u3002\r\n\u25CF\u5931\u8D25\uFF1A\u7532\u866B\u7FA4\u653B\u51FB\uFF0C\u635F\u59311\u5FC3\uFF0C\u5C04\u901F-0.5\u3002\r\n\u9009\u9879B
      \u2014\u2014 \u5C06\u8150\u5375\u8E29\u788E\r\n\u25CF\u6210\u529F\u7387\uFF1A100%\r\n\u25CF\u7ED3\u679C\uFF1A\u8150\u5375\u7206\u51FA\u8113\u6DB2\uFF0C\u6E85\u5230\u4F60\u7684\u6B66\u5668\u4E0A\uFF0C\u653B\u51FB+20%\u3002\r\n\r\n\r\n\u9053\u5177\r\n\u9053\u517701\uFF1A\u67AF\u6728\u9022\u6625\r\n\u25CF\u63CF\u8FF0\uFF1A\u4E00\u6839\u770B\u4F3C\u67AF\u6B7B\u7684\u6811\u679D\uFF0C\u63D2\u5165\u6CE5\u571F\u540E\u4F1A\u5FEB\u901F\u751F\u6839\u53D1\u82BD\u3002\r\n\u25CF\u6548\u679C\uFF1A\u6BCF\u6B21\u6218\u6597\u7ED3\u675F\u65F6\u6062\u590D0.5\u5FC3\uFF0C\u751F\u65483\u6B21\u540E\u67AF\u840E\u6D88\u5931\u3002\r\n\u9053\u517702\uFF1A\u788E\u88C2\u7684\u62A4\u8EAB\u7B26\r\n\u25CF\u63CF\u8FF0\uFF1A\u4E00\u5757\u88C2\u6210\u4E24\u534A\u7684\u62A4\u7B26\uFF0C\u7F3A\u53E3\u5904\u6709\u5E72\u6DB8\u7684\u8840\u8FF9\uFF0C\u6563\u53D1\u7740\u5FAE\u5F31\u7684\u5B88\u62A4\u4E4B\u529B\u3002\r\n\u25CF\u6548\u679C\uFF1A\u53D7\u5230\u81F4\u547D\u4F24\u5BB3\u65F6\u4FDD\u75590.5\u5FC3\u4E0D\u6B7B\uFF0C\u968F\u540E\u62A4\u8EAB\u7B26\u7834\u788E\u6D88\u5931\uFF08\u4E00\u6B21\u6027\uFF09\u3002\r\n\u9053\u517703\uFF1A\u9F39\u9F20\u7259\u9F7F\r\n\u25CF\u63CF\u8FF0\uFF1A\u4E00\u9897\u5F02\u5E38\u5C16\u9510\u7684\u9F39\u9F20\u95E8\u7259\uFF0C\u636E\u8BF4\u4F69\u6234\u5728\u8170\u95F4\u80FD\u8BA9\u6316\u6398\u53D8\u5F97\u8F7B\u677E\u3002\r\n\u25CF\u6548\u679C\uFF1A\u6BCF\u6B21\u6218\u6597\u989D\u5916\u6389\u843D2\u91D1\u5E01\u3002\u6C38\u4E45\u6709\u6548\u3002\r\n\u9053\u517704\uFF1A\u8424\u706B\u866B\u56CA\r\n\u25CF\u63CF\u8FF0\uFF1A\u9EBB\u5E03\u7F1D\u5236\u7684\u5C0F\u56CA\u888B\uFF0C\u91CC\u9762\u88C5\u7740\u5341\u51E0\u53EA\u6D3B\u8424\u706B\u866B\uFF0C\u6563\u53D1\u7740\u67D4\u548C\u7684\u9EC4\u7EFF\u8272\u5149\u3002\r\n\u25CF\u6548\u679C\uFF1A\u5C04\u7A0B+1\u3002\u6C38\u4E45\u6709\u6548\u3002\r\n\u9053\u517705\uFF1A\u8150\u70C2\u53F7\u89D2\r\n\u25CF\u63CF\u8FF0\uFF1A\u4E00\u53EA\u7528\u8150\u70C2\u6728\u5934\u96D5\u6210\u7684\u53F7\u89D2\uFF0C\u5439\u4E0D\u51FA\u58F0\u97F3\u3002\r\n\u25CF\u6548\u679C\uFF1A\u6BCF\u573A\u6218\u6597\u5F00\u59CB\u65F6\uFF0C\u6240\u6709\u654C\u4EBA\u505C\u6B62\u79FB\u52A83\u79D2,\u6C38\u4E45\u6709\u6548\u3002\r\n\u9053\u517706\uFF1A\u8715\u76AE\u58F3\r\n\u25CF\u63CF\u8FF0\uFF1A\u4E00\u5F20\u5B8C\u6574\u7684\u86C7\u8715\uFF0C\u8584\u5982\u8749\u7FFC\uFF0C\u6708\u5149\u4E0B\u6CDB\u94F6\u8272\u5149\u6CFD\u3002\r\n\u25CF\u6548\u679C\uFF1A\u83B7\u5F971\u6B21\u5E87\u62A4(\u53EF\u4EE5\u963B\u6321\u4EFB\u610F\u4E00\u6B21\u653B\u51FB),\u751F\u6548\u540E\u7834\u635F,\u7ACB\u523B\u5728\u81EA\u8EAB3\u683C\u8303\u56F4\u5185\u751F\u6210\u6BD2\u6C14\u5708,\u7EF4\u63012\u79D2,1\u79D22\u4F24.(\u5BF9\u81EA\u8EAB\u65E0\u4F24,\u53EA\u5BF9\u654C)\r\n\u9053\u517707\uFF1A\u8840\u82D4\u7EF7\u5E26\r\n\u25CF\u63CF\u8FF0\uFF1A\u6D78\u8FC7\u7329\u7EA2\u82D4\u85D3\u6C41\u6DB2\u7684\u9EBB\u5E03\u7EF7\u5E26\uFF0C\u6577\u5728\u4F24\u53E3\u4E0A\u6709\u707C\u70E7\u523A\u75DB\u611F\u3002\r\n\u25CF\u6548\u679C\uFF1A\u8840\u91CF\uFF1E0.5\u8840\u65F6,\u6BCF\u6B21\u8FDB\u5165\u65B0\u623F\u95F4\u90FD\u6263\u96640.5\u8840,\u4F24\u5BB3+0.5,\u6C38\u4E45\u6709\u6548\u3002\r\n\u9053\u517708\uFF1A\u67AF\u53F6\u6597\u7BF7\r\n\u25CF\u63CF\u8FF0\uFF1A\u7528\u79CB\u5929\u7684\u67AF\u53F6\u7F1D\u6210\u7684\u6597\u7BF7\uFF0C\u6563\u53D1\u8150\u673D\u6CE5\u571F\u6C14\u606F\uFF0C\u62AB\u4E0A\u540E\u51E0\u4E4E\u4E0E\u68EE\u6797\u878D\u4E3A\u4E00\u4F53\u3002\r\n\u25CF\u6548\u679C\uFF1A\u7AD9\u7ACB\u4E0D\u52A83\u79D2\u540E\u8FDB\u5165\u4F2A\u88C5\uFF0C\u654C\u4EBA\u65E0\u6CD5\u53D1\u73B0\u4F60\uFF08\u653B\u51FB\u6216\u79FB\u52A8\u89E3\u9664\uFF09\u3002\u6C38\u4E45\u6709\u6548\u3002\r\n\u9053\u517709\uFF1A\u8702\u540E\u871C\r\n\u25CF\u63CF\u8FF0\uFF1A\u4E00\u5C0F\u7F50\u91D1\u9EC4\u8272\u8702\u871C\uFF0C\u5473\u9053\u751C\u4E2D\u5E26\u82E6\u3002\r\n\u25CF\u6548\u679C\uFF1A\u653B\u51FB\u529B+0.5\uFF0C\u4F46\u6BCF\u6B21\u6218\u6597\u5F00\u59CB(\u53EA\u9650\u6218\u6597\u623F)\u65F6\u670950%\u6982\u7387\u989D\u5916\u751F\u62102\u4E2A\u654C\u4EBA,\u6C38\u4E45\u6709\u6548\u3002\r\n\u9053\u517710\uFF1A\u77F3\u5316\u79CD\u5B50\r\n\u25CF\u63CF\u8FF0\uFF1A\u7070\u767D\u8272\u575A\u786C\u79CD\u5B50\uFF0C\u6CA1\u6709\u53D1\u82BD\u8FF9\u8C61\uFF0C\u4E22\u51FA\u53BB\u50CF\u77F3\u5934\u4E00\u6837\u7838\u4EBA\u3002\r\n\u25CF\u6548\u679C\uFF1A\u6BCF\u6B21\u653B\u51FB,\u670910%\u7684\u6982\u7387\u5BF9\u654C\u4EBA\u9020\u6210\u77F3\u5316(\u9759\u6B62\u4E0D\u52A82\u79D2,\u77F3\u5316\u72B6\u6001\u4E0B\u65E0\u6CD5\u653B\u51FB\u79FB\u52A8,\u65E0\u6CD5\u53D7\u5230\u4F24\u5BB3),\u6C38\u4E45\u6709\u6548\u3002\r\n\u9053\u517711\uFF1A\u72FC\u4EBA\u7684\u6307\u5C16\r\n\u25CF\u63CF\u8FF0\uFF1A\u4E00\u622A\u5E72\u67AF\u7684\u624B\u6307\u9AA8\uFF0C\u5C16\u7AEF\u6709\u950B\u5229\u722A\u75D5\uFF0C\u6234\u4E0A\u540E\u624B\u6307\u4E0D\u7531\u81EA\u4E3B\u5F2F\u66F2\u3002\r\n\u25CF\u6548\u679C\uFF1A\u5C04\u7A0B-0.5,\u653B\u51FB+0.5,\u6BCF\u6B21\u653B\u51FB\u654C\u4EBA\u670920%\u7684\u6982\u7387\u9020\u6210\u6050\u614C1.5\u79D2(\u505C\u6B62\u653B\u51FB,\u5C3D\u53EF\u80FD\u8FDC\u79BB\u4E3B\u89D2)\u3002\r\n\u9053\u517712\uFF1A\u6708\u8680\u788E\u7247\r\n\u25CF\u63CF\u8FF0\uFF1A\u6697\u7EA2\u8272\u6708\u7259\u5F62\u788E\u7247\uFF0C\u8FB9\u7F18\u950B\u5229\uFF0C\u8868\u9762\u6709\u8150\u8680\u75D5\u8FF9\u3002\r\n\u25CF\u6548\u679C\uFF1A\u672C\u573A\u6218\u6597\u5185\u8840\u91CF\u4E0A\u9650+1\u3002\r\n\r\n"
